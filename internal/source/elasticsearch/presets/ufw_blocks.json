{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {"range": {"@timestamp": {"gte": "{{.From}}", "lte": "{{.To}}"}}},
        {"term": {"ufw.action.keyword": "BLOCK"}}
      ],
      "must_not": [
        {"terms": {"destination.ip.keyword": ["255.255.255.255"]}},
        {"regexp": {"destination.ip.keyword": "(22[4-9]|23[0-9])[.].*"}},
        {"prefix": {"destination.ip.keyword": "ff02:"}},
        {"bool": {"filter": [
          {"term": {"client.port": 1900}},
          {"bool": {"should": [
            {"prefix": {"client.ip.keyword": "192.168."}},
            {"prefix": {"client.ip.keyword": "10."}}
          ], "minimum_should_match": 1}}
        ]}}
      ]
    }
  },
  "aggs": {"breakdown": {"terms": {"field": "client.ip.keyword", "size": 10}}}
}
